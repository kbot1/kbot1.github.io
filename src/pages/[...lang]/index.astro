---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TravailItem from '../../components/TravailItem.astro';
import Mindmap from '../../components/Mindmap.astro';
import { SITE } from '../../site.config';
import { useT, href, tr, fmtDate, langFromParam, langPaths } from '../../i18n';
import { getTravaux, getPosts } from '../../lib';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);

const travaux = await getTravaux();
const articles = travaux.filter((x) => x.data.type === 'article');
const congres = travaux.filter((x) => x.data.type !== 'article');
const stats = [
  { n: articles.length, label: t('stats.articles'), path: '/publications/' },
  { n: travaux.filter((x) => x.data.type === 'poster').length, label: t('stats.posters'), path: '/congres/?type=poster' },
  { n: travaux.filter((x) => x.data.type === 'oral').length, label: t('stats.orals'), path: '/congres/?type=oral' },
  { n: travaux.filter((x) => x.data.type === 'resume').length, label: t('stats.resumes'), path: '/congres/?type=resume' },
];
const cartes = (await getCollection('cartes')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const featured = cartes[0];
const posts = (await getPosts()).slice(0, 3);
---

<Base lang={lang}>
  <section class="hero">
    <div class="container hero-in">
      <div class="portrait">
        {SITE.portrait ? <img src={SITE.portrait} alt={SITE.name} /> : <span>{SITE.initials}</span>}
      </div>
      <div>
        <h1>{SITE.name}</h1>
        <p class="role">{SITE.role[lang]}</p>
        <p class="bio">{SITE.bio[lang]}</p>
        <div class="chips">
          {SITE.email && <a class="btn primary" href={`mailto:${SITE.email}`}>Contact</a>}
          {SITE.links.filter((l) => l.url).map((l) => <a class="btn" href={l.url} target="_blank" rel="me noopener">{l.label}</a>)}
        </div>
      </div>
    </div>
    <svg class="isolines" viewBox="0 0 600 400" aria-hidden="true">
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <ellipse cx="430" cy="210" rx={60 + i * 42} ry={38 + i * 30} transform={`rotate(-18 430 210)`} />
      ))}
    </svg>
  </section>

  <div class="container">
    <section class="stats">
      {stats.map((s) => (
        <a class="stat" href={href(lang, s.path)}>
          <strong>{s.n}</strong>
          <span>{s.label}</span>
        </a>
      ))}
    </section>

    <div class="two-col">
      <section>
        <div class="sec-head">
          <h2>{t('latestPubs')}</h2>
          <a href={href(lang, '/publications/')}>{t('seeAll')} →</a>
        </div>
        {articles.slice(0, 4).map((item) => <TravailItem item={item} lang={lang} compact />)}
      </section>
      <section>
        <div class="sec-head">
          <h2>{t('latestTalks')}</h2>
          <a href={href(lang, '/congres/')}>{t('seeAll')} →</a>
        </div>
        {congres.slice(0, 4).map((item) => <TravailItem item={item} lang={lang} compact />)}
      </section>
    </div>

    {
      featured && (
        <section>
          <div class="sec-head">
            <h2>{t('featuredMap')} · {tr(featured.data, 'title', lang)}</h2>
            <a href={href(lang, `/cartes/${featured.id}/`)}>{t('mm.full')} →</a>
          </div>
          <Mindmap markdown={featured.body ?? ''} lang={lang} height="440px" expandLevel={featured.data.expandLevel} toolbar={false} />
        </section>
      )
    }

    {
      posts.length > 0 && (
        <section>
          <div class="sec-head">
            <h2>{t('latestPosts')}</h2>
            <a href={href(lang, '/blog/')}>{t('seeAll')} →</a>
          </div>
          <div class="grid">
            {posts.map((p) => (
              <a class="card" href={href(lang, `/blog/${p.id}/`)}>
                <span class="muted small">{fmtDate(p.data.date, lang)} · {p.data.lang.toUpperCase()}</span>
                <h3>{p.data.title}</h3>
                <p class="muted small">{p.data.summary}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--bg-soft), var(--bg));
  }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: auto 1fr; gap: 2.5rem; align-items: center; }
  .portrait {
    width: 150px; height: 150px; border-radius: 50%; overflow: hidden; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-text); font: 600 3rem var(--serif);
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--line);
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  h1 { margin-bottom: 0.2rem; }
  .role { margin: 0 0 1rem; color: var(--accent); font-weight: 600; }
  .bio { max-width: 60ch; color: var(--muted); font-size: 1.07rem; margin: 0 0 1.3rem; }
  .isolines { position: absolute; right: -60px; top: -20px; width: 640px; height: auto; pointer-events: none; }
  .isolines ellipse { fill: none; stroke: var(--accent); stroke-width: 1; opacity: 0.12; }
  @media (max-width: 700px) {
    .hero { padding-top: 2.5rem; }
    .hero-in { grid-template-columns: 1fr; gap: 1.25rem; }
    .portrait { width: 104px; height: 104px; font-size: 2.1rem; }
  }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 2.25rem 0 0.5rem; }
  .stat {
    display: flex; flex-direction: column; padding: 1rem 1.2rem; border: 1px solid var(--line); border-radius: var(--radius);
    text-decoration: none; color: var(--muted); background: var(--bg-card); transition: border-color 0.15s;
  }
  .stat:hover { border-color: var(--accent); }
  .stat strong { font: 600 2rem var(--serif); color: var(--text); line-height: 1.1; }
  .stat span { font-size: 0.88rem; }
  @media (max-width: 700px) { .stats { grid-template-columns: repeat(2, 1fr); } }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0 3rem; }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-top: 2.5rem; }
  .sec-head h2 { margin: 0 0 0.5rem; font-size: 1.4rem; }
  .sec-head a { font-size: 0.9rem; white-space: nowrap; text-decoration: none; }
  .card h3 { margin: 0.3rem 0; }
</style>
