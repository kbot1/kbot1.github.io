---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { useT, href, fmtDate, langFromParam } from '../../../i18n';
import { getPosts } from '../../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return [undefined, 'en'].flatMap((lang) => posts.map((p) => ({ params: { lang, slug: p.id }, props: { post: p } })));
}
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
const { Content } = await render(post);
---

<Base lang={lang} title={post.data.title} description={post.data.summary} image={post.data.cover}>
  <article class="container">
    <header class="page-head">
      <a class="small" href={href(lang, '/blog/')} style="text-decoration:none">← {t('back')}</a>
      <p class="small muted" style="margin-top:1rem">{fmtDate(post.data.date, lang)}</p>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p>{post.data.summary}</p>}
    </header>
    {post.data.cover && <img class="cover" src={post.data.cover} alt="" />}
    <div class="prose" lang={post.data.lang}>
      <Content />
    </div>
  </article>
</Base>

<style>
  .cover { width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--radius); margin-bottom: 2rem; }
</style>
