---
import Base from '../../../layouts/Base.astro';
import { useT, href, fmtDate, langFromParam, langPaths } from '../../../i18n';
import { getPosts } from '../../../lib';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
// Les billets dans la langue courante d'abord, puis les autres.
const posts = (await getPosts()).sort((a, b) => Number(b.data.lang === lang) - Number(a.data.lang === lang));
---

<Base lang={lang} title={t('nav.blog')}>
  <div class="container">
    <header class="page-head">
      <h1>{t('nav.blog')}</h1>
      <p>{t('blog.intro')}</p>
    </header>
    <div class="posts">
      {
        posts.map((p) => (
          <a class="post" href={href(lang, `/blog/${p.id}/`)}>
            {p.data.cover && <img src={p.data.cover} alt="" loading="lazy" />}
            <div>
              <span class="muted small">
                {fmtDate(p.data.date, lang)} · <span class="badge">{p.data.lang.toUpperCase()}</span>
              </span>
              <h2>{p.data.title}</h2>
              <p class="muted">{p.data.summary}</p>
              {p.data.tags.length > 0 && <span class="small muted">{p.data.tags.map((x) => `#${x}`).join('  ')}</span>}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .posts { display: grid; gap: 0.5rem; max-width: 820px; }
  .post { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); text-decoration: none; color: inherit; }
  .post img { width: 160px; height: 110px; object-fit: cover; border-radius: 8px; }
  .post h2 { font-size: 1.3rem; margin: 0.3rem 0; }
  .post:hover h2 { color: var(--accent); }
  .post p { margin: 0 0 0.3rem; }
  @media (max-width: 600px) { .post { grid-template-columns: 1fr; } .post img { width: 100%; height: 160px; } }
</style>
