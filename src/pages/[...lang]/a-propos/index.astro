---
import Base from '../../../layouts/Base.astro';
import FilterableList from '../../../components/FilterableList.astro';
import { SITE } from '../../../site.config';
import { useT, href, langFromParam, langPaths } from '../../../i18n';
import { getTravaux } from '../../../lib';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
const articles = await getTravaux(['article']);
---

<Base lang={lang} title={t('nav.apropos')}>
  <section class="hero">
    <div class="container hero-in">
      <div class="portrait">
        {SITE.portrait ? <img src={SITE.portrait} alt={SITE.name} /> : <span>{SITE.initials}</span>}
      </div>
      <div>
        <h1>{SITE.name}</h1>
        <p class="role">{SITE.role[lang]}</p>
        <p class="bio">{SITE.bio[lang]}</p>
        <div class="chips">
          {SITE.email && <a class="btn primary" href={`mailto:${SITE.email}`}>Contact</a>}
          {SITE.links.filter((l) => l.url).map((l) => <a class="btn" href={l.url} target="_blank" rel="me noopener">{l.label}</a>)}
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <h2>{t('apropos.pubs')}</h2>
    <FilterableList items={articles} lang={lang} />

    <h2>{t('apropos.more')}</h2>
    <div class="chips">
      <a class="btn" href={href(lang, '/cartes/')}>{t('nav.cartes')}</a>
      <a class="btn" href={href(lang, '/galerie/')}>{t('nav.galerie')}</a>
    </div>
  </div>
</Base>

<style>
  .hero { padding: 3.5rem 0 3rem; border-bottom: 1px solid var(--line); background: linear-gradient(180deg, var(--bg-soft), var(--bg)); }
  .hero-in { display: grid; grid-template-columns: auto 1fr; gap: 2.5rem; align-items: center; }
  .portrait {
    width: 150px; height: 150px; border-radius: 50%; overflow: hidden; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-text); font: 600 3rem var(--serif);
    box-shadow: 0 0 0 6px var(--bg), 0 0 0 7px var(--line);
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  h1 { margin-bottom: 0.2rem; }
  .role { margin: 0 0 1rem; color: var(--accent); font-weight: 600; }
  .bio { max-width: 60ch; color: var(--muted); font-size: 1.05rem; margin: 0 0 1.3rem; }
  @media (max-width: 700px) {
    .hero-in { grid-template-columns: 1fr; gap: 1.25rem; }
    .portrait { width: 104px; height: 104px; font-size: 2.1rem; }
  }
</style>
