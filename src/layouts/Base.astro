---
import '../styles/global.css';
import { SITE } from '../site.config';
import { useT, href, stripLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}
const { lang, title, description, image } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${SITE.title[lang]}` : `${SITE.title[lang]} — ${SITE.role[lang]}`;
const desc = description ?? SITE.bio[lang];
const basePath = stripLang(Astro.url.pathname);
const altLang: Lang = lang === 'fr' ? 'en' : 'fr';

const nav = [
  { key: 'nav.veille', path: '/' },
  { key: 'nav.revues', path: '/revues/' },
  { key: 'nav.cartes', path: '/cartes/' },
  { key: 'nav.galerie', path: '/galerie/' },
  { key: 'nav.apropos', path: '/a-propos/' },
] as const;

function isActive(p: string) {
  if (p === '/') return basePath === '/' || basePath.startsWith('/veille/');
  if (p === '/a-propos/') return ['/a-propos/', '/publications/', '/travaux/', '/congres/'].some((x) => basePath.startsWith(x));
  return basePath.startsWith(p);
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(href('fr', basePath), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', basePath), Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title[lang]} — ${t('veille.title')}`} href={href(lang, '/rss.xml')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={href(lang, '/')}>
          {SITE.portraitMini ? <img class="mono photo" src={SITE.portraitMini} alt="" width="34" height="34" /> : <span class="mono">{SITE.initials}</span>}
          <span class="brand-name">{SITE.title[lang]}</span>
        </a>
        <button class="icon-btn menu-btn" aria-label={t('menu')} aria-expanded="false" aria-controls="nav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <nav id="nav" class="nav">
          {nav.map((n) => (
            <a href={href(lang, n.path)} aria-current={isActive(n.path) ? 'page' : undefined}>{t(n.key)}</a>
          ))}
          <span class="tools">
            <a class="lang" href={href(altLang, basePath)} hreflang={altLang} lang={altLang}>
              <span class:list={{ on: lang === 'fr' }}>FR</span><span class="sep">/</span><span class:list={{ on: lang === 'en' }}>EN</span>
            </a>
            <button class="icon-btn theme-btn" aria-label={t('theme')} title={t('theme')}>
              <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            </button>
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="links">
          <a href={href(lang, '/rss.xml')}>{t('rss')}</a>
          {SITE.links.filter((l) => l.url).map((l) => <a href={l.url} rel="me noopener" target="_blank">{l.label}</a>)}
        </span>
        <span class="muted small">{t('footer')}</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector('.theme-btn')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
      const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const nav = document.getElementById('nav');
      menuBtn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', String(!!open));
      });
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: saturate(1.4) blur(10px);
        border-bottom: 1px solid var(--line);
      }
      .bar { display: flex; align-items: center; gap: 1rem; min-height: 64px; }
      .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--text); }
      .mono {
        display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px;
        background: var(--accent); color: var(--accent-text); font: 700 0.85rem var(--sans); letter-spacing: 0.04em;
      }
      .mono.photo { border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1px var(--line); }
      .brand-name { font-family: var(--serif); font-weight: 600; font-size: 1.1rem; white-space: nowrap; }
      .nav { margin-left: auto; display: flex; align-items: center; gap: 0.25rem; }
      .nav > a {
        padding: 0.4rem 0.7rem; border-radius: 6px; color: var(--muted); text-decoration: none; font-size: 0.92rem; font-weight: 500;
      }
      .nav > a:hover { color: var(--text); background: var(--bg-soft); }
      .nav > a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }
      .tools { display: flex; align-items: center; gap: 0.35rem; margin-left: 0.6rem; padding-left: 0.8rem; border-left: 1px solid var(--line); }
      .lang { font: 600 0.8rem var(--sans); text-decoration: none; color: var(--muted); padding: 0.3rem 0.4rem; }
      .lang .on { color: var(--accent); }
      .lang .sep { margin: 0 0.15rem; opacity: 0.5; }
      .icon-btn {
        display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid transparent; border-radius: 8px;
        background: none; color: var(--muted); cursor: pointer;
      }
      .icon-btn:hover { color: var(--text); background: var(--bg-soft); }
      .icon-btn svg { width: 19px; height: 19px; }
      :global(:root[data-theme='dark']) .sun { display: none; }
      :global(:root:not([data-theme='dark'])) .moon { display: none; }
      .menu-btn { display: none; margin-left: auto; }

      @media (max-width: 900px) {
        .menu-btn { display: grid; }
        .nav {
          display: none; position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; align-items: stretch;
          background: var(--bg); border-bottom: 1px solid var(--line); padding: 0.75rem 1.25rem 1rem; gap: 0.1rem;
        }
        .nav.open { display: flex; }
        .nav > a { padding: 0.65rem 0.7rem; }
        .tools { margin: 0.5rem 0 0; padding: 0.6rem 0 0; border-left: 0; border-top: 1px solid var(--line); }
      }

      main { min-height: 70vh; padding-bottom: 4rem; }
      .site-footer { border-top: 1px solid var(--line); background: var(--bg-soft); padding: 2rem 0; font-size: 0.9rem; }
      .foot { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; align-items: center; justify-content: space-between; }
      .links { display: flex; flex-wrap: wrap; gap: 1rem; }
      .links a { color: var(--muted); text-decoration: none; }
      .links a:hover { color: var(--accent); }
    </style>
  </body>
</html>
